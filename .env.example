# Diamond Fibre Environment Configuration
# Official production domain (https://diamondfibre.shop) or Vercel preview (https://diamond-fibre.vercel.app):
NEXT_PUBLIC_SITE_URL=https://diamondfibre.shop

# Contact Phone & WhatsApp Number
NEXT_PUBLIC_CONTACT_PHONE=+917974644185
NEXT_PUBLIC_WHATSAPP_NUMBER=917974644185

# Wholesale Form Ingestion (Resend Transactional Email)
# 1. Recipient: The owner's destination inbox (can be an existing Gmail address, e.g., owner@gmail.com)
WHOLESALE_RECIPIENT_EMAIL=diamondfibreandcotton@gmail.com

# 2. Resend API Key: From your Resend dashboard (re_...)
# Keep on server only. NEVER prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# 3. Verified Sender: Must use a domain or sender identity verified in Resend (e.g., wholesale@diamondfibre.com or onboarding@resend.dev for testing).
# NOTE: Senders CANNOT use a personal @gmail.com address because Resend requires SPF/DKIM verification on a domain you control.
WHOLESALE_FROM_EMAIL=
